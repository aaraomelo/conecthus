# URL da API do backend. Emulador Android usa 10.0.2.2 para host loopback.
# Para testar em dispositivo físico, use o IP da sua máquina na rede local.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api

# URL do broker MQTT via WebSockets. Deve apontar para o listener 8083 do mosquitto.
EXPO_PUBLIC_MQTT_URL=ws://10.0.2.2:8083
# EXPO_PUBLIC_MQTT_URL=ws://192.168.0.10:8083
